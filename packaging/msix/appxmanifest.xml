<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:uap13="http://schemas.microsoft.com/appx/manifest/uap/windows10/13"
         xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
         IgnorableNamespaces="rescap uap uap3 uap5 uap13 desktop6">
  <!-- Version and ProcessorArchitecture are rewritten by build.ps1. -->
  <Identity Name="JanDeDobbeleer.Waku" Version="0.0.0.0" Publisher="CN=Jan Joris De Dobbeleer, O=Jan Joris De Dobbeleer, L=Diest, C=BE" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>waku</DisplayName>
    <PublisherDisplayName>Jan Joris De Dobbeleer</PublisherDisplayName>
    <Description>A top bar for Windows, configured in QML.</Description>
    <Logo>icons\store.png</Logo>
    <!-- The config home, %LOCALAPPDATA%\waku and the registry are shared with unpackaged tools
         (wakuc from a terminal, editors), so never redirect writes into the package. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <uap13:AutoUpdate>
      <uap13:AppInstaller File="install.appinstaller" />
    </uap13:AutoUpdate>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="Waku" Executable="waku.exe" EntryPoint="Windows.FullTrustApplication">
      <uap3:VisualElements DisplayName="waku" Description="A top bar for Windows" Square150x150Logo="icons\icon.png" Square44x44Logo="icons\44.png" BackgroundColor="#1e2030" AppListEntry="default">
      </uap3:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="waku.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="waku.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
    <!-- wakuc, the console client, gets its own alias and no Start entry. -->
    <Application Id="Wakuc" Executable="wakuc.exe" EntryPoint="Windows.FullTrustApplication">
      <uap3:VisualElements DisplayName="wakuc" Description="waku console client" Square150x150Logo="icons\icon.png" Square44x44Logo="icons\44.png" BackgroundColor="#1e2030" AppListEntry="none">
      </uap3:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="wakuc.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="wakuc.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
    <!-- wakukeys, the hotkey daemon (a GUI program), gets its own alias and no Start entry. -->
    <Application Id="Wakukeys" Executable="wakukeys.exe" EntryPoint="Windows.FullTrustApplication">
      <uap3:VisualElements DisplayName="wakukeys" Description="waku hotkey daemon" Square150x150Logo="icons\icon.png" Square44x44Logo="icons\44.png" BackgroundColor="#1e2030" AppListEntry="none">
      </uap3:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="wakukeys.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="wakukeys.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
