#!/bin/sh
# commit-msg: enforce conventional commit subjects (see AGENTS.md).
# Enable with: git config core.hooksPath tools/hooks

msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | tr -d '\r' | sed -n '/[^[:space:]]/{p;q;}')

case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

scopes='kernel|control|host|ui|quickshell|app|apps|desktop_state|audio|bluetooth|brightness|clock|color_scheme|control_center|github|media|network|notifications|quickshell_io|system_stats|taskbar|tray|wallpapers|workspaces|build|docs|test|style|chore'
pattern="^(feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert)(\(($scopes)\))?!?: .+"
if printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

echo "commit-msg: subject is not a conventional commit:" >&2
echo "  $subject" >&2
echo "expected: type(scope)?: subject, e.g. 'fix(host): reject list roots'" >&2
echo "types: feat fix refactor perf test docs build ci chore style revert" >&2
echo "scopes: kernel control host ui app, a feature name (audio ... workspaces), build docs test style chore" >&2
exit 1
