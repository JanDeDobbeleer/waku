{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "arm64-debug",
      "inherits": "base",
      "displayName": "ARM64 Debug",
      "architecture": { "value": "arm64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static-md",
        "YASB_QT_DIR": "msvc2022_arm64"
      }
    },
    {
      "name": "arm64-release",
      "inherits": "base",
      "displayName": "ARM64 Release",
      "architecture": { "value": "arm64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static-md",
        "YASB_QT_DIR": "msvc2022_arm64"
      }
    },
    {
      "name": "x64-release",
      "inherits": "base",
      "displayName": "x64 Release",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "YASB_QT_DIR": "msvc2022_64"
      }
    }
  ],
  "buildPresets": [
    { "name": "arm64-debug", "configurePreset": "arm64-debug" },
    { "name": "arm64-release", "configurePreset": "arm64-release" },
    { "name": "x64-release", "configurePreset": "x64-release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    { "name": "arm64-debug", "inherits": "base", "configurePreset": "arm64-debug" },
    { "name": "arm64-release", "inherits": "base", "configurePreset": "arm64-release" },
    { "name": "x64-release", "inherits": "base", "configurePreset": "x64-release" }
  ]
}
