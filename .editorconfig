root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Git runs hooks with sh; they must stay LF.
[{tools/hooks/*,*.sh}]
end_of_line = lf
