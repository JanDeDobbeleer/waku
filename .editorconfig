root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Git runs hooks with sh; they must stay LF.
[{tools/hooks/*,*.sh}]
end_of_line = lf

# Generated by generate_options.py (LF, its own indentation). Never hand-edit.
[core/config/options/*.h]
end_of_line = lf
indent_size = unset

# Parity oracle: vectors, fixtures and the exported schema are byte-exact LF output of
# tools/parity. Editors must not touch whitespace or line endings.
[{tests/vectors/**,tools/parity/fixtures/**,schema/schema.json}]
charset = unset
indent_style = unset
indent_size = unset
end_of_line = lf
insert_final_newline = unset
trim_trailing_whitespace = unset
